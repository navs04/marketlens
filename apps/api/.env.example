# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Local Postgres started via infra/docker-compose.yml uses these defaults.
DATABASE_URL="postgresql://marketlens:marketlens@localhost:5432/marketlens?schema=public"

