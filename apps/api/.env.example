# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Local Postgres started via infra/docker-compose.yml uses these defaults.
DATABASE_URL="postgresql://marketlens:marketlens@localhost:5432/marketlens?schema=public"

# --- AI explanations (optional) ---
# Without this, the explanation endpoint falls back to a deterministic,
# template-based explanation built from the same structured numbers - the
# app works identically either way.
# ANTHROPIC_API_KEY=

# --- data.gov.in ingestion (Milestone 2) ---
# Register a free key at https://www.data.gov.in/user/register - the
# shared public "sample" key is heavily rate-limited and not meant for
# real use.
DATA_GOV_IN_API_KEY=
# Defaults below match the "Current Daily Price of Various Commodities
# from Various Markets (Mandi)" resource; override only if you know you
# need a different one.
# DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource
# INGEST_COMMODITIES=Onion,Potato,Tomato,Green Chilli,Cauliflower,Brinjal
# INGEST_PAGE_LIMIT=100
# INGEST_MAX_RECORDS_PER_COMMODITY=1500
# INGEST_MAX_PAGES_PER_COMMODITY=50
